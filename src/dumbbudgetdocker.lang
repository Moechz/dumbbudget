# ===========================================================================
# Multilingual file for the TOS 7 Docker application "dumbbudgetdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "DumbBudget"
auth         = "DumbWare"
version      = "@@VERSION@@"
descript     = "DumbBudget is a small self-hosted budget tracker: record income and expenses with categories, see the running balance, filter by date range, sort by date or amount, and export to CSV or PDF. It supports recurring transactions, 24 currencies, a light/dark theme, an installable PWA and an optional PIN gate. This package runs the official upstream image as a non-root container and keeps your transactions in a single local JSON file: no account, no telemetry, no cloud service."
release_note = "2026.11.14-3 - review remediation: official multi-arch upstream image (aarch64 startup fixed), PRIVACY.md and NOTICE.md added, README completed, descriptions and data paths corrected, GPL-3.0 attribution. T1 upstream CVE retained with reason."
important    = "Open http://<NAS-IP>:8161/. Set DUMBBUDGET_PIN in the container environment to require a PIN; without it the UI is open to your LAN. Transactions are saved in /Volume1/DockerAppData/dumbbudgetdocker/data/app/data/transactions.json and survive restarts and updates. PDF export loads jsPDF from cdnjs.cloudflare.com and needs internet; CSV works offline. Plain HTTP on the LAN - never expose port 8161 to the internet. Back up the data folder before uninstalling with data removal."

[zh-cn]
name         = "DumbBudget"
auth         = "DumbWare"
version      = "@@VERSION@@"
descript     = "DumbBudget 是一个自托管的简易记账应用：按类别记录收入与支出，实时查看余额，按日期范围筛选、按日期或金额排序，并可导出 CSV 或 PDF。支持周期性交易、24 种货币、浅色/深色主题、可安装为 PWA，以及可选的 PIN 访问保护。本包以非 root 容器运行官方上游镜像，交易数据保存在本机单个 JSON 文件中：无需账号，无遥测，也不经过云端。"
release_note = "2026.11.14-3 — 审核整改：改用官方多架构上游镜像（修复 arm64 启动失败），新增隐私政策与许可证声明，补全 README，修正描述与数据路径，补充 GPL-3.0 署名；T1 上游 CVE 说明保留原因。"
important    = "打开 http://<NAS-IP>:8161/。在容器环境中设置 DUMBBUDGET_PIN 可启用 PIN 保护；未设置时局域网内任何人都能打开界面。交易数据保存在 /Volume1/DockerAppData/dumbbudgetdocker/data/app/data/transactions.json，重启和升级后仍在。PDF 导出会从 cdnjs.cloudflare.com 加载 jsPDF，需要联网；CSV 导出可离线使用。局域网内为 HTTP，请勿将 8161 端口暴露到公网。卸载并删除数据前请备份。"

[zh-hk]
name         = "DumbBudget"
auth         = "DumbWare"
version      = "@@VERSION@@"
descript     = "DumbBudget 是一個自託管的簡易記帳應用：按類別記錄收入與支出，即時查看餘額，按日期範圍篩選、按日期或金額排序，並可匯出 CSV 或 PDF。支援週期性交易、24 種貨幣、淺色/深色主題、可安裝為 PWA，以及可選的 PIN 存取保護。本包以非 root 容器執行官方上游映像，交易資料保存在本機單一 JSON 檔案中：無需帳號，無遙測，也不經過雲端。"
release_note = "2026.11.14-3 — 審核整改：改用官方多架構上游映像（修復 arm64 啟動失敗），新增隱私政策與授權聲明，補全 README，修正描述與資料路徑，補充 GPL-3.0 署名；T1 上游 CVE 說明保留原因。"
important    = "開啟 http://<NAS-IP>:8161/。在容器環境中設定 DUMBBUDGET_PIN 可啟用 PIN 保護；未設定時區域網路內任何人都能開啟介面。交易資料保存在 /Volume1/DockerAppData/dumbbudgetdocker/data/app/data/transactions.json，重新啟動和升級後仍在。PDF 匯出會從 cdnjs.cloudflare.com 載入 jsPDF，需要連網；CSV 匯出可離線使用。區域網路內為 HTTP，請勿將 8161 連接埠暴露到公網。解除安裝並刪除資料前請備份。"

